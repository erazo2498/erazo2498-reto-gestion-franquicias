# Copy to .env (never commit it) and adjust. Used by docker-compose.yml and, when exported, by the application.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=franquicias
DB_USERNAME=franquicias
DB_PASSWORD=change_me_locally

# Set to true when the database requires TLS (RDS PostgreSQL 16 does); ECS injects it from Secrets Manager.
DB_SSL=false
