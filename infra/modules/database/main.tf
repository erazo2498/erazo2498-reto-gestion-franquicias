# PostgreSQL on RDS in private subnets. The master password is generated by RDS and stored in
# AWS Secrets Manager (`manage_master_user_password`), so it never appears in the code, the variables or the state.

locals {
  name = "${var.project}-${var.environment}"
}

resource "aws_db_subnet_group" "this" {
  name       = local.name
  subnet_ids = var.subnet_ids

  tags = { Name = local.name }
}

resource "aws_db_instance" "this" {
  identifier = local.name

  engine         = "postgres"
  engine_version = var.engine_version
  instance_class = var.instance_class

  allocated_storage = var.allocated_storage
  storage_type      = "gp3"
  storage_encrypted = true

  db_name                     = var.db_name
  username                    = var.username
  manage_master_user_password = true

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [var.security_group_id]
  publicly_accessible    = false
  multi_az               = var.multi_az

  backup_retention_period    = var.backup_retention_days
  auto_minor_version_upgrade = true
  skip_final_snapshot        = var.skip_final_snapshot
  final_snapshot_identifier  = var.skip_final_snapshot ? null : "${local.name}-final"
  deletion_protection        = var.deletion_protection
  apply_immediately          = true

  tags = { Name = local.name }
}

# Connection settings (host, port, database, TLS) kept in Secrets Manager next to the RDS-managed credentials, so the
# application receives every DB_* value from secrets. The password is NOT written here: it stays only in the secret
# that RDS generates, so it never reaches the Terraform state.
resource "aws_secretsmanager_secret" "connection" {
  name                    = "${var.project}/${var.environment}/db-connection"
  description             = "Database connection settings for ${local.name}"
  recovery_window_in_days = var.skip_final_snapshot ? 0 : 7

  tags = { Name = "${local.name}-db-connection" }
}

resource "aws_secretsmanager_secret_version" "connection" {
  secret_id = aws_secretsmanager_secret.connection.id
  secret_string = jsonencode({
    host   = aws_db_instance.this.address
    port   = tostring(aws_db_instance.this.port)
    dbname = aws_db_instance.this.db_name
    ssl    = "true" # RDS PostgreSQL 16 requires encrypted connections
  })
}
